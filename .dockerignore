node_modules
**/node_modules

# 本地密钥与运行产物 —— 绝不能进构建上下文 / 镜像层
.env
.env.*
.run
.worktrees
# all-in-one 的默认数据目录（./data:/data）：整个 Postgres + 明文密钥，别进上下文
/data

# AI 工作区，与镜像无关
.trellis
.agents
.dsh

support
# 例外：all-in-one 镜像的入口脚本必须进构建上下文（Dockerfile.allinone 会 COPY 它）。
# 常规 Dockerfile 不 COPY support/，多一个未被使用的上下文文件不改变它的产物与行为。
!support/allinone-entrypoint.sh
backend/dist
frontend/dist
shared/dist
**/.angular

.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*

yarn-error.log
temp

.vscode
.git
