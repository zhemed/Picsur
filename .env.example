# Picsur 环境变量示例 —— 复制成 .env 后修改，.env 不进版本库
#
# 常驻部署：cp .env.example .env && docker compose up -d --build   # 用仓库根目录的 docker-compose.yml
# 本地开发：set -a; . ./.env; set +a; node backend/dist/main.js

# ---- 必填 ----
# admin 账号名固定为 admin，这个口令是它的初始密码
PICSUR_ADMIN_PASSWORD=change-me-please
# 不设置则每次重启随机生成，会导致所有登录态失效
PICSUR_JWT_SECRET=change-me-too

# ---- 数据库（compose 内部使用服务名；本机开发用 127.0.0.1）----
PICSUR_DB_HOST=picsur_postgres
PICSUR_DB_PORT=5432
PICSUR_DB_USERNAME=picsur
PICSUR_DB_PASSWORD=picsur
PICSUR_DB_DATABASE=picsur

# ---- 服务 ----
PICSUR_PORT=8080
PICSUR_STATIC_FRONTEND_ROOT=/picsur/frontend/dist
# 上传大小上限（字节），默认 128MB
PICSUR_MAX_FILE_SIZE=128000000
# 生产模式：TypeORM 不做 synchronize，只跑 migration，必须开
PICSUR_PRODUCTION=true
