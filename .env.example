# Picsur 环境变量示例 —— 复制成 .env 后修改，.env 不进版本库
#
# 常驻部署：cp .env.example .env && docker compose up -d --build   # 用仓库根目录的 docker-compose.yml
# 本地开发：set -a; . ./.env; set +a; node backend/dist/main.js

# ---- 必填 ----
# admin 账号名固定为 admin，这个口令是它的初始密码
PICSUR_ADMIN_PASSWORD=change-me-please
# 不设置则每次重启随机生成，会导致所有登录态失效
PICSUR_JWT_SECRET=change-me-too

# ---- 数据库（compose 内部使用服务名；本机开发用 127.0.0.1）----
PICSUR_DB_HOST=picsur_postgres
PICSUR_DB_PORT=5432
PICSUR_DB_USERNAME=picsur
PICSUR_DB_PASSWORD=picsur
PICSUR_DB_DATABASE=picsur

# ---- 服务 ----
PICSUR_PORT=8080
PICSUR_STATIC_FRONTEND_ROOT=/picsur/frontend/dist
# 上传大小上限（字节），默认 128MB
PICSUR_MAX_FILE_SIZE=128000000
# 图像像素上限（宽x高），默认 268402689（sharp 默认 0x3FFF^2）；超限的上传会返回 400 并回显该上限。
# 0 表示不限制（不推荐：超大图会显著吃内存）。
PICSUR_MAX_IMAGE_PIXELS=268402689
# 生产模式：TypeORM 不做 synchronize，只跑 migration，必须开
PICSUR_PRODUCTION=true

# ---- 遥测（当前是装饰性开关）----
# 本仓库已在代码层断掉遥测：ReportUrl 编译期为空（backend/src/config/config.static.ts），
# 无论这里和系统首选项 enable_telemetry 怎么设，都不会出网。
# 保留此变量只为消除启动日志里的提示差异。
PICSUR_TELEMETRY=false

# ---- 在线升级（面板里的「关于与升级」区块）----
# 版本检测：默认开启。只读公共的 https://api.github.com/repos/zhemed/picsur/tags，
# 一小时最多一次，不发任何实例/用户数据；关掉后接口会明确返回「功能已关闭」。
# PICSUR_UPDATE_CHECK=false
#
# 自升级：**默认开启**（compose 里是 `${PICSUR_ALLOW_SELF_UPDATE:-true}`，后端默认值同为 true）。
# 真正的门槛是「有没有把宿主 docker socket 挂进容器」—— 挂上就等于把宿主 docker 的 root
# 权限交给面板，任何管理员都能借此起特权容器，只适合完全信任管理员的单机部署：
#   - compose / install.sh 路径：docker-compose.yml 默认已挂 /var/run/docker.sock
#   - all-in-one：`docker run` 时自己加 -v /var/run/docker.sock:/var/run/docker.sock
# 想关掉：**删掉挂载** 并设 PICSUR_ALLOW_SELF_UPDATE=false（此时面板只展示可复制的升级命令）。
# PICSUR_ALLOW_SELF_UPDATE=false
#
# 可选微调（一般不用设）：
# PICSUR_UPDATE_REPO=zhemed/picsur          # 换仓库存放 tags 的位置
# PICSUR_UPDATE_IMAGE=ghcr.io/zhemed/picsur # 拉取镜像的仓库（默认取当前容器镜像的仓库）
# PICSUR_UPDATE_TAG=latest                  # 固定拉取某个 tag（all-in-one 部署会忽略它，见下）
# PICSUR_UPDATE_TIMEOUT=5000                # GitHub 查询超时（毫秒，默认 5000，网络慢可调大）
# PICSUR_DOCKER_SOCKET=/var/run/docker.sock # socket 路径（默认值）
#
# PICSUR_UPDATE_TAG 的两个例外（有意行为）：
#   1) all-in-one 部署（容器 tag 形如 `allinone`）会忽略它：换成普通版本 tag 会拉到常规镜像，
#      入口不同、起不来，所以自升级只重新拉取当前在跑的那个 tag（日志里会有一条 WARN）。
#   2) 设了 PICSUR_UPDATE_IMAGE 时以它为准。

# ---- 千万不要开 ----
# PICSUR_VERBOSE=true 会把 JWT secret 与数据库口令明文写进日志
PICSUR_VERBOSE=false
